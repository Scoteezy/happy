<?xml version="1.0" encoding="utf-8"?>
<!--
  Development builds talk to a local server over plain HTTP
  (`happy-server standalone:dev` on http://10.0.2.2:3005 from the emulator),
  as happy-app's Expo development client and happy-ios's dev build allow.
  Preview and release builds keep the platform's default: HTTPS only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application
        android:name="com.slopus.happy.harness.ShellHarnessApplication"
        android:usesCleartextTraffic="true"
        tools:replace="android:name,android:usesCleartextTraffic">
        <activity android:name="com.slopus.happy.harness.ShellHarnessActivity"
            android:exported="true" android:theme="@style/Theme.Happy" />
        <!-- Stories over a computer of its own (happy-ios's `-screen stories`); see StoriesHarnessActivity. -->
        <activity
            android:name="com.slopus.happy.harness.StoriesHarnessActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|fontScale|density"
            android:exported="true"
            android:theme="@style/Theme.Happy" />
        <!-- The linked Tailcat library against addresses that go nowhere; see TailcatProbeActivity. -->
        <activity
            android:name="com.slopus.happy.harness.TailcatProbeActivity"
            android:exported="true"
            android:theme="@style/Theme.Happy" />
        <!-- Stem Cells over the harness's computer (the iOS reference host's fixture); see StemCellsHarnessActivity. -->
        <activity
            android:name="com.slopus.happy.harness.StemCellsHarnessActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|fontScale|density"
            android:exported="true"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.Happy" />
    </application>
</manifest>
